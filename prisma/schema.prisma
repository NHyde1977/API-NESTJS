generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Aluno {
  id    Int     @id @default(autoincrement())
  nome  String  @db.VarChar(100)
  curso String  @db.VarChar(100)
  email String? @db.VarChar(150)

  cursoId      Int?
  cursoRelacao Curso? @relation(fields: [cursoId], references: [id])

  @@map("alunos")
}

model Disciplina {
  id           Int    @id @default(autoincrement())
  nome         String @db.VarChar(100)
  cargaHoraria Int    @map("carga_horaria")

  @@map("disciplinas")
}

model Curso {
  id   Int    @id @default(autoincrement())
  nome String @db.VarChar(100)

  alunos Aluno[]

  @@map("cursos")
}
